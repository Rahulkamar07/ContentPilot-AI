# ==============================================================================
# ContentPilot AI - Environment Variable Template
# ==============================================================================

# General Application Settings
PROJECT_NAME="ContentPilot AI"
ENVIRONMENT="development"
DEBUG=true
GIT_COMMIT="dev-commit"

# Security & JWT Tokens
SECRET_KEY="super-secret-jwt-signing-key-minimum-32-characters-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_DB=contentpilot_db
POSTGRES_USER=contentpilot_user
POSTGRES_PASSWORD=SecureDbPassword123!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://contentpilot_user:SecureDbPassword123!@postgres:5432/contentpilot_db

# Redis Broker & Cache Configuration
REDIS_PASSWORD=SecureRedisPassword123!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:SecureRedisPassword123!@redis:6379/0

# Optional AI API Provider Credentials
OPENAI_API_KEY=""
GEMINI_API_KEY=""
